<%- include('../partials/head', { titulo: 'Fornecedores' }) %>
<div class="cabecalho">
  <h1>Fornecedores</h1>
  <a class="botao" href="/fornecedores/novo">Novo fornecedor</a>
</div>
<%- include('../partials/erros', { erros }) %>
<% if (fornecedores.length === 0) { %>
  <p class="vazio">Nenhum fornecedor cadastrado.</p>
<% } else { %>
  <div class="tabela-wrap">
    <table>
      <thead>
        <tr><th>ID</th><th>Nome</th><th></th></tr>
      </thead>
      <tbody>
        <% fornecedores.forEach((fornecedor) => { %>
          <tr>
            <td class="num"><%= fornecedor._id %></td>
            <td><%= fornecedor.nome %></td>
            <td class="acoes">
              <a class="botao secundario" href="/fornecedores/<%= fornecedor._id %>/editar">Editar</a>
              <form method="post" action="/fornecedores/<%= fornecedor._id %>/excluir" onsubmit="return confirm('Excluir este fornecedor?')">
                <button class="perigo" type="submit">Excluir</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
  </main>
</body>
</html>
