<% const editando = Boolean(produto._id); %>
<%- include('../partials/head', { titulo: editando ? 'Editar produto' : 'Novo produto' }) %>
<h1><%= editando ? `Editar produto #${produto._id}` : 'Novo produto' %></h1>
<%- include('../partials/erros', { erros }) %>
<form class="formulario" method="post" action="<%= editando ? `/produtos/${produto._id}` : '/produtos' %>">
  <label>Nome
    <input name="nome" value="<%= produto.nome %>" required>
  </label>
  <label>Quantidade em estoque
    <input name="qtdeEstoque" type="number" min="0" step="1" value="<%= produto.qtdeEstoque %>" required>
  </label>
  <label>Preço (R$)
    <input name="preco" type="number" min="0" step="0.01" value="<%= produto.preco %>" required>
  </label>
  <label>Fornecedor
    <select name="_idFornFK">
      <option value="">Sem fornecedor</option>
      <% fornecedores.forEach((fornecedor) => { %>
        <option value="<%= fornecedor._id %>" <%= String(fornecedor._id) === String(produto._idFornFK) ? 'selected' : '' %>><%= fornecedor.nome %></option>
      <% }) %>
    </select>
  </label>
  <div class="acoes-form">
    <button type="submit">Salvar</button>
    <a class="botao secundario" href="/produtos">Cancelar</a>
  </div>
</form>
  </main>
</body>
</html>
