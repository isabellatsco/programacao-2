generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model aircraft {
  aircraft_id  Int      @id @default(autoincrement())
  model        String?  @db.VarChar(100)
  manufacturer String?  @db.VarChar(100)
  capacity     Int?
  flight       flight[]
}

model boarding_pass {
  boarding_pass_id Int        @id @default(autoincrement())
  seat_number      String?    @db.VarChar(5)
  passenger_id     Int?
  flight_id        Int?
  issue_time       DateTime?  @db.Timestamp(6)
  flight           flight?    @relation(fields: [flight_id], references: [flight_id], onDelete: NoAction, onUpdate: NoAction)
  passenger        passenger? @relation(fields: [passenger_id], references: [passenger_id], onDelete: NoAction, onUpdate: NoAction)
}

model flight {
  flight_id         Int             @id @default(autoincrement())
  flight_number     String?         @db.VarChar(10)
  departure_airport String?         @db.VarChar(10)
  arrival_airport   String?         @db.VarChar(10)
  departure_time    DateTime?       @db.Timestamp(6)
  arrival_time      DateTime?       @db.Timestamp(6)
  aircraft_id       Int?
  boarding_pass     boarding_pass[]
  aircraft          aircraft?       @relation(fields: [aircraft_id], references: [aircraft_id], onDelete: NoAction, onUpdate: NoAction)
}

model passenger {
  passenger_id    Int             @id @default(autoincrement())
  first_name      String?         @db.VarChar(50)
  last_name       String?         @db.VarChar(50)
  birth_date      DateTime?       @db.Date
  passport_number String?         @unique @db.VarChar(20)
  boarding_pass   boarding_pass[]
}

model sys_user {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(255)
  login_email String @unique @db.VarChar(150)
  password    String @db.VarChar(255)
  user_type   String @db.VarChar(10)
}
